APP_ENV="development"
# In production: APP_ENV="production", HTTPS origins/callback, and DATABASE_URL
# with sslmode=require (or verify-full). Keep the existing encryption key.
# Prefer a dedicated non-admin DB login. For the accepted private-demo exception
# only, explicitly set ALLOW_ADMIN_DATABASE_FOR_PRIVATE_DEMO="true" in hosting.
# This does not make postgres least-privilege. Leave unset for normal deployment.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@SESSION_POOLER_HOST:5432/postgres"
SUPABASE_URL="https://PROJECT_REF.supabase.co"

GEMINI_API_KEY="replace_me"
GEMINI_MODEL="gemini-3.5-flash"

GOOGLE_CLIENT_ID="replace_me.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace_me"
GOOGLE_REDIRECT_URI="http://localhost:8000/gmail/callback"
TOKEN_ENCRYPTION_KEY="replace_me"

FRONTEND_URL="http://localhost:3000"
WORKER_POLL_SECONDS="5"
# Development defaults to local polling; production defaults to cloud_run.
# GMAIL_SYNC_DISPATCH="cloud_run"
# CLOUD_RUN_PROJECT="gmailrag-501319"
# CLOUD_RUN_REGION="us-west1"
# GMAIL_SYNC_JOB_NAME="gmailrag-worker"
