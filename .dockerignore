# Allowlist only packaging inputs, Python code/tests, and schema regression fixtures.
**
!backend/
!backend/Dockerfile
!backend/cloudbuild.yaml
!backend/constraints.txt
!backend/requirements*.txt
!backend/model-artifacts.json
!backend/container/
!backend/container/debian.sources
!backend/app/
!backend/app/*.py
!backend/scripts/
!backend/scripts/*.py
!backend/tests/
!backend/tests/*.py
!backend/db/
!backend/db/schema.sql
!backend/db/migrations/
!backend/db/migrations/*.sql
!.dockerignore
!.gcloudignore
**/.env
**/.env.*
**/credentials*.json
**/token*.json
**/*.pem
**/*.key
