# Do not upload the full workspace or import .gitignore implicitly.
# Explicitly include only the same audited build inputs as .dockerignore.
**
!backend/
!backend/Dockerfile
!backend/cloudbuild.yaml
!backend/constraints.txt
!backend/requirements*.txt
!backend/model-artifacts.json
!backend/container/
!backend/container/debian.sources
!backend/app/
!backend/app/*.py
!backend/scripts/
!backend/scripts/*.py
!backend/tests/
!backend/tests/*.py
!supabase/
!supabase/schema.sql
!supabase/migrations/
!supabase/migrations/*.sql
!.dockerignore
!.gcloudignore
**/.env
**/.env.*
**/credentials*.json
**/token*.json
**/*.pem
**/*.key
